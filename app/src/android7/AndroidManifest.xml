<?xml version="1.0" encoding="utf-8"?>
<!--
  Overlay di manifest per la variante "android7".

  Contesto: molte smart TV (AKAI ed economico in generale) montano una ROM
  AOSP "tablet" adattata alla TV, priva della feature "android.software.leanback"
  e del launcher Android TV ufficiale.

  Il manifest principale dichiara:
    - <uses-feature android:software.leanback required="true">
    - l'activity di ingresso con la SOLA categoria LEANBACK_LAUNCHER

  Su quei dispositivi l'app si installerebbe ma NON comparirebbe in nessun
  launcher (nessun intent-filter LAUNCHER riconoscibile) -> di fatto inutilizzabile.

  Qui:
    1) leanback diventa opzionale (required=false)
    2) si aggiunge la categoria LAUNCHER per i launcher standard (Launcher3/AOSP)
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.software.leanback"
        android:required="false"
        tools:replace="android:required" />

    <application>
        <!--
          L'attivity mantiene il suo intent-filter LEANBACK_LAUNCHER originale;
          qui ne aggiungiamo uno separato con MAIN + LAUNCHER.
          Se il merger dovesse unirli in un unico filtro (richiederebbe ENTRAMBE
          le categorie) il build va corretto: verificato su manifest merged.
        -->
        <activity
            android:name=".ui.profile.ProfileSelectionActivity"
            tools:node="merge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
