{
  "rules": {
    "sessions": {
      "$session": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChild('type') && newData.child('type').isString()",
        "$field": {
          ".validate": "newData.isString() && newData.val().length < 1024"
        }
      }
    },
    "app_update": {
      ".read": true,
      ".write": false
    },
    "app_update_android7": {
      ".read": true,
      ".write": false
    },
    "vpn_configs": {
      ".read": true,
      ".write": false
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
